# Server Environment Variables (server/.env)

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/food-app?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/food-app

# JWT Secret Key used for signing auth tokens
JWT_SECRET=pg_food_waste_secret_key_2026_jwt_token_secure

# Allowed CORS Origins (Comma-separated URLs for production frontends)
# Example: https://pg-food-waste.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174
